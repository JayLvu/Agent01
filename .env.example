# DeepSeek API 配置(从 https://platform.deepseek.com 获取)
DEEK_SEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek 模型配置
DEEK_SEEK_BASE_URL=https://api.deepseek.com
DEEK_SEEK_MODEL=deepseek-chat
DEEK_SEEK_TEMPERATURE=0.7
DEEK_SEEK_MAX_TOKENS=2048

# Redis 配置(记忆管理 + 向量库)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 服务器配置
SERVER_PORT=8080

# H2 数据库密码(审计日志 / Token 成本 / 定时任务持久化)
H2_PASSWORD=

# 联网搜索(可选): 使用 serper 需要 API Key,留空则用 duckduckgo(免费)
# SERPER_API_KEY=

# 文档上传目录
DOCS_UPLOAD_DIR=./data/docs
DOCS_CHUNK_SIZE=500
DOCS_CHUNK_OVERLAP=100
